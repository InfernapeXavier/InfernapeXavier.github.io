{
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "node scripts/check-runtime.mjs && npm exec --yes --package=bun@1.4.4 -- bun install --frozen-lockfile",
  "buildCommand": "node scripts/check-runtime.mjs && npm exec --yes --package=bun@1.4.4 -- bun run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
