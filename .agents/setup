#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

# Install the patched Bun release when the base Orb image is older.
BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
export BUN_INSTALL
export PATH="$BUN_INSTALL/bin:$PATH"

if ! bun --version | awk -F. 'NR == 1 { exit !($1 > 1 || ($1 == 1 && ($2 > 4 || ($2 == 4 && $3 >= 4)))) }'; then
  curl -fsSL https://bun.com/install | bash -s -- bun-v1.4.4
fi

# Reject vulnerable bundled decoders before downloading dependencies.
echo "Checking the orb toolchain..."
node --version
bun --version
node scripts/check-runtime.mjs --bun

# Debian backports the Brotli fix; curl links against this system library.
if ! dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libbrotli1)" ge '1.0.9-2+deb12u1'; then
  sudo apt-get update
  sudo apt-get install -y --only-upgrade libbrotli1 libbrotli-dev
  dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libbrotli1)" ge '1.0.9-2+deb12u1'
fi

# Keep dependencies and Bun's cache in the snapshot. Bun cheaply checks warm installs.
echo "Installing locked dependencies (including development tools)..."
time NODE_ENV=development bun install --frozen-lockfile
